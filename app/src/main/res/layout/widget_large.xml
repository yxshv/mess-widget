<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_lunch"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                style="@style/StatusPill"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/meal"
                style="@style/MealName"
                android:layout_marginStart="7dp"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/price"
                style="@style/PricePill"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/time"
                style="@style/TimeText"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headline"
            style="@style/Headline"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/sides"
            style="@style/Sides"
            android:layout_marginTop="5dp"
            android:maxLines="3"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="108dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/art_lunch" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/prev"
                style="@style/NavButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/previous_meal"
                android:src="@drawable/ic_chevron_left" />

            <ImageView
                android:id="@+id/next"
                style="@style/NavButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/next_meal"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
